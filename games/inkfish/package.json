{
  "name": "@16bitink/inkfish",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./content": "./content/paid.ts",
    "./build-id": "./build-id.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "dev": "vite dev --port 5174",
    "dev:crazygames": "vite dev --config vite.crazygames.config.ts --port 5176",
    "build:crazygames": "vite build --config vite.crazygames.config.ts && cd dist/crazygames && rm -f ../inkfish-crazygames.zip && zip -qr ../inkfish-crazygames.zip .",
    "promo": "node dev/promo/record.mjs",
    "banner": "node dev/promo/saveBanner.mjs",
    "thumbnail": "node dev/promo/saveThumbnail.mjs",
    "ads": "node dev/promo/saveAds.mjs"
  },
  "dependencies": {
    "@16bitink/game-sdk": "workspace:*",
    "mediabunny": "1.61.3",
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.3",
    "playwright-core": "1.56.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
