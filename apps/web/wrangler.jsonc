{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "16bitink",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // Serve only on 16bit.ink so cookies and Stripe redirects stay on one origin.
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "routes": [{ "pattern": "16bit.ink", "custom_domain": true }],
  "vars": {
    // Set to "true" once Stripe Tax is configured in the dashboard.
    "STRIPE_AUTOMATIC_TAX": "false"
  }
  // Secrets (wrangler secret put …): STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET,
  // ENTITLEMENT_SECRET
}
