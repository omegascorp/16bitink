---
import { homeGames, playableGames, type CatalogGame } from '../../data/games';
import { PASS, passPitch, passRiseNote } from '../../data/pass';
import { appleTouchIcon } from '../../lib/manifest';
import { GAME_VERSIONS } from '../../games/versions';
import { coverSrcset, coverVariant } from '../../lib/covers';

export function getStaticPaths() {
  return playableGames().map((game) => ({ params: { slug: game.slug }, props: { game } }));
}

interface Props {
  game: CatalogGame;
}
const { game } = Astro.props;
const theme = game.theme ?? { paper: '#f4eddc', ink: '#1b1a1f', accent: '#1f3f8a' };
const version = GAME_VERSIONS[game.slug];
const cover = game.cover ?? '/covers/inkfish.png';
const fontFamilies = ['family=Silkscreen', game.fonts?.googleCss].filter(Boolean).join('&');
// The pass, offered next to the game when a player taps "Unlock" (lib/client/buyChooser.ts).
// Static pages: the count is the games out at build time, and every Sunday's release deploys.
const gameCount = Math.max(homeGames(new Date()).length, 1);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <!-- viewport-fit=cover + safe-area padding: edge-to-edge on notched phones -->
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover" />
    <title>Play {game.title} | 16bit.ink</title>
    <meta name="description" content={game.tagline} />
    <meta name="theme-color" content={theme.paper} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content={game.title} />
    <!-- Installs as its own app: the game's manifest and icon, not the catalog's. -->
    <link rel="manifest" href={`/play/${game.slug}.webmanifest`} />
    <link rel="apple-touch-icon" href={appleTouchIcon(game)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={`https://fonts.googleapis.com/css2?${fontFamilies}&display=swap`} rel="stylesheet" />
  </head>
  <body style={`--paper:${theme.paper};--ink:${theme.ink};--accent:${theme.accent}`}>
    <div id="stage" aria-label={`${game.title} game`} data-game={game.slug} data-title={game.title} data-price={game.price ?? ''} data-pass-price={PASS.price} data-pass-pitch={passPitch(gameCount)} data-pass-note={passRiseNote(gameCount) ?? ''} data-fonts={JSON.stringify(game.fonts?.await ?? [])}>
      <div id="splash">
        <p class="brand"><span class="bits">16bit</span><span class="ink">.ink</span></p>
        <!-- What you're about to play, while there's room for it (not on a phone held sideways). Usually cached from the home page. -->
        <picture class="shot">
          <source type="image/avif" srcset={coverSrcset(cover, 'avif')} sizes="min(420px, 80vw)" />
          <source type="image/webp" srcset={coverSrcset(cover, 'webp')} sizes="min(420px, 80vw)" />
          <img src={coverVariant(cover, 640, 'webp')} alt="" width="1200" height="675" decoding="async" />
        </picture>
        <h1>{game.title}</h1>
        <p class="tag">{game.tagline}</p>
        <p class="free">No download · No sign-up</p>
        <button id="play" type="button">Tap to play</button>
        <div id="loader" hidden>
          <div id="loader-bar" class="bar" role="progressbar" aria-label={`Loading ${game.title}`} aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
            <div id="loader-fill" class="fill"><span class="hatch"></span></div>
          </div>
          <p class="loader-label"><span id="loader-step"></span><span id="loader-pct">0%</span></p>
        </div>
        <p id="ios-hint" hidden>Tip: Share → <strong>Add to Home Screen</strong> for true full-screen on iPhone.</p>
        <p id="status" role="status"></p>
        <a class="back" href={`/games/${game.slug}`}>← back</a>
        {version && <p class="version">v{version}</p>}
      </div>
    </div>

    <script>
      import { trackPageview } from '../../lib/client/analytics';
      import { watchErrors, watchPage } from '../../lib/client/pageWatch';
      import { bootPlayer } from '../../lib/client/player';

      trackPageview();
      watchPage();
      watchErrors();

      const stage = document.getElementById('stage');
      if (stage?.dataset.game) bootPlayer(stage.dataset.game, JSON.parse(stage.dataset.fonts ?? '[]') as string[]);
    </script>

    <style is:global>
      html, body { margin: 0; height: 100%; overflow: hidden; background: var(--paper); overscroll-behavior: none; }
      /* Inset by the safe areas so a notch or home bar never covers the HUD; the paper fills behind them. */
      #stage {
        position: fixed;
        top: env(safe-area-inset-top); right: env(safe-area-inset-right); left: env(safe-area-inset-left);
        height: calc(100dvh - env(safe-area-inset-top) - env(safe-area-inset-bottom));
        touch-action: none; user-select: none; -webkit-user-select: none; -webkit-touch-callout: none;
        background: var(--paper);
      }
      #stage canvas { display: block; }
      #splash {
        position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center;
        gap: 8px; padding: 0 16px; text-align: center;
        font-family: 'Caveat', cursive; color: var(--ink); z-index: 2;
        /* Covers the game's canvas while it boots underneath, then fades out. */
        background: var(--paper); transition: opacity 0.32s ease-out;
      }
      #splash.leaving { opacity: 0; pointer-events: none; }
      #splash h1 { font-size: clamp(4rem, 16vw, 8rem); margin: 0; line-height: 0.9; color: var(--accent); }
      .tag { font-size: 1.8rem; margin: 0; }
      .free { font-family: Georgia, serif; font-size: 0.95rem; margin: 2px 0 18px; opacity: 0.75; }
      .shot { display: block; margin: 10px 0 4px; }
      .shot img {
        display: block; width: min(420px, 80vw); height: auto; box-sizing: border-box;
        border: 3px solid var(--ink); box-shadow: 3px 4px 0 var(--ink); transform: rotate(-1deg);
      }
      @media (max-height: 640px) { .shot { display: none; } }
      .brand { font-size: 1.6rem; margin: 0; }
      .brand .bits { font-family: 'Silkscreen', monospace; font-size: 1.1rem; }
      .brand .ink { color: var(--accent); }
      #play {
        font: 700 2.2rem 'Caveat', cursive; padding: 10px 36px; min-height: 60px; cursor: pointer;
        color: var(--paper); background: var(--accent); border: 3px solid var(--ink);
        border-radius: 255px 15px 225px 15px / 15px 225px 15px 255px; box-shadow: 3px 4px 0 var(--ink);
      }
      #play:active { transform: translate(2px, 3px); box-shadow: none; }
      #play:focus-visible { outline: 3px dashed var(--accent); outline-offset: 5px; }
      #loader { display: flex; flex-direction: column; align-items: center; width: min(340px, 78vw); min-height: 60px; }
      #loader[hidden] { display: none; }
      .bar {
        position: relative; width: 100%; height: 24px; box-sizing: border-box; overflow: hidden;
        background: var(--paper); border: 3px solid var(--ink);
        border-radius: 255px 15px 225px 15px / 15px 225px 15px 255px; box-shadow: 3px 4px 0 var(--ink);
      }
      .fill {
        position: absolute; inset: 0 auto 0 0; width: 0; overflow: hidden;
        background: color-mix(in srgb, var(--accent) 22%, var(--paper));
        border-right: 2px solid var(--ink); box-sizing: border-box;
        transition: width 0.25s ease-out;
      }
      /* Pen hatching that keeps crawling, also while the game is busy drawing (a transform runs off the main thread). */
      .hatch {
        position: absolute; top: 0; bottom: 0; left: -14px; width: calc(100vw + 28px);
        background-image: linear-gradient(45deg, var(--accent) 22%, transparent 22%, transparent 50%, var(--accent) 50%, var(--accent) 72%, transparent 72%);
        background-size: 14px 14px;
        animation: hatch 0.7s linear infinite;
      }
      @keyframes hatch { to { transform: translateX(14px); } }
      @media (prefers-reduced-motion: reduce) { .hatch { animation: none; } }
      .loader-label { display: flex; justify-content: space-between; gap: 12px; width: 100%; margin: 8px 0 0; font-size: 1.5rem; line-height: 1; }
      #loader-pct { font-family: 'Silkscreen', monospace; font-size: 0.95rem; align-self: center; }
      #ios-hint, #status { font-family: Georgia, serif; font-size: 0.95rem; max-width: 34ch; margin: 8px 0 0; }
      #status { color: #a3342b; }
      .back { font-size: 1.5rem; color: var(--ink); margin-top: 14px; }
      .version {
        position: absolute; right: 14px; bottom: 10px; margin: 0;
        font-family: 'Silkscreen', monospace; font-size: 0.7rem; color: var(--ink); opacity: 0.55;
      }
      /* "This game or every game?", over the game when a player taps Unlock (lib/client/buyChooser.ts). */
      .buy-chooser {
        box-sizing: border-box; width: min(420px, calc(100vw - 32px)); max-height: calc(100dvh - 32px); overflow: auto;
        padding: 20px 20px 14px; color: var(--ink); background: var(--paper);
        border: 3px solid var(--ink); border-radius: 4px; box-shadow: 4px 5px 0 var(--ink);
        font-family: Georgia, serif; user-select: none; -webkit-user-select: none;
      }
      .buy-chooser::backdrop { background: rgb(20 18 24 / 0.55); }
      .buy-chooser-title { margin: 0 0 12px; font: 700 2.2rem/1 'Caveat', cursive; color: var(--accent); text-align: center; }
      .buy-choice {
        position: relative; display: flex; flex-direction: column; gap: 2px; width: 100%; margin: 0 0 12px; padding: 12px 14px;
        text-align: left; font: inherit; color: var(--ink); background: var(--paper); cursor: pointer;
        border: 3px solid var(--ink); border-radius: 255px 15px 225px 15px / 15px 225px 15px 255px; box-shadow: 3px 4px 0 var(--ink);
      }
      .buy-choice:active { transform: translate(2px, 3px); box-shadow: none; }
      .buy-choice:focus-visible { outline: 3px dashed var(--accent); outline-offset: 4px; }
      .buy-choice-pass { color: var(--paper); background: var(--accent); }
      .buy-choice-head { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; }
      .buy-choice-name { font: 700 1.7rem/1.05 'Caveat', cursive; }
      .buy-choice-price { font: 0.95rem 'Silkscreen', monospace; white-space: nowrap; }
      .buy-choice-line { font-size: 0.92rem; line-height: 1.3; }
      .buy-choice-pass .buy-choice-line:first-of-type { font-weight: 700; }
      .buy-choice-sticker {
        position: absolute; top: -12px; right: 14px; padding: 2px 8px; transform: rotate(3deg);
        font: 0.7rem 'Silkscreen', monospace; color: var(--ink); background: #f3d34a; border: 2px solid var(--ink);
      }
      .buy-chooser-note { margin: 2px 0 8px; font-size: 0.85rem; text-align: center; opacity: 0.8; }
      .buy-chooser-close {
        display: block; margin: 0 auto; padding: 6px 14px; cursor: pointer;
        font: 700 1.4rem 'Caveat', cursive; color: var(--ink); background: none; border: 0; text-decoration: underline;
      }
    </style>
  </body>
</html>
