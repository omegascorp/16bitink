---
import Base from '../layouts/Base.astro';
import GameSpread from '../components/GameSpread.astro';
import PartnerAd from '../components/PartnerAd.astro';
import SundaySignup from '../components/SundaySignup.astro';
import { homeGames, homeListings } from '../data/games';
import { currentUser, ownedGameSlugs } from '../lib/owner';
import { siteJsonLd } from '../lib/seo';

// Rendered per request, so owners see "Play" instead of "Play free".
export const prerender = false;

const now = new Date();
// Two games at the top: the newest (a game dated ahead takes this slot on its release day, with
// no deploy) and the most played. Then the rest, newest first.
const { top, rest } = homeListings(now);
const games = homeGames(now);
const titles = games.map((g) => g.title);
const named = titles.length > 1 ? `${titles.slice(0, -1).join(', ')} and ${titles.at(-1)}` : titles.join('');
let owned = new Set<string>();
let user: { name: string; email: string } | null | undefined;
try {
  const [slugs, session] = await Promise.all([ownedGameSlugs(Astro.cookies, Astro.url), currentUser(Astro.cookies)]);
  owned = slugs;
  user = session && { name: session.name, email: session.email };
} catch (err) {
  // The home page must always load: fall back to "Play free" and let the header look up the user in the browser.
  console.error('[home] ownership check failed', err);
}
Astro.response.headers.set('cache-control', 'private, no-store');
---
<Base
  title="16bit.ink: free pen-and-ink games for your browser"
  description={`Small games drawn with a pen: ${named}. Play free in your browser, full-screen, with no download and no sign-up.`}
  image="/covers/home.jpg"
  user={user}
  jsonLd={[siteJsonLd(Astro.site ?? Astro.url)]}
>
  <!-- Displacement filter shared by every cover: redraws the wobble 8 times a second. -->
  <svg width="0" height="0" aria-hidden="true" focusable="false" style="position:absolute">
    <filter id="boil">
      <feTurbulence type="fractalNoise" baseFrequency="0.035" numOctaves="2" seed="1">
        <animate attributeName="seed" values="1;2;3" dur="0.375s" calcMode="discrete" repeatCount="indefinite" />
      </feTurbulence>
      <feDisplacementMap in="SourceGraphic" scale="2.6" />
    </filter>
  </svg>

  <div class="hero">
    <h1 class="intro">Small games, drawn with a pen. <span class="weekly">A new one every Sunday.</span></h1>
    <ul class="perks" aria-label="How it works">
      <li>Free to start</li>
      <li>No download</li>
      <li>No sign-up</li>
    </ul>
  </div>
  <!-- Each top card says why it is there; the rest wear no sticker, so the two labels don't compete with more. -->
  <div class="games">
    {top.map(({ game, label }, i) => <GameSpread game={game} owned={owned.has(game.slug)} position={i + 1} featured label={label} />)}
  </div>
  {rest.length > 0 && (
    <section class="more" aria-labelledby="more-games">
      <h2 id="more-games" class="more-title">More games</h2>
      <div class="games">
        {rest.map((game, i) => <GameSpread game={game} owned={owned.has(game.slug)} position={top.length + i + 1} />)}
      </div>
    </section>
  )}
  <!-- Anyone who has bought a game sees no ads. -->
  {owned.size === 0 && <PartnerAd />}
  <SundaySignup />
</Base>

<style>
  .hero { margin: 8px 0 44px; }
  .intro { margin: 0; font-size: clamp(1.9rem, 4vw, 2.5rem); font-weight: 700; color: var(--ink); }
  .weekly { color: var(--blue-ink); white-space: nowrap; }
  .perks {
    display: flex; flex-wrap: wrap; gap: 4px 22px; margin: 6px 0 0; padding: 0; list-style: none;
    font-family: var(--font-hand); font-size: 1.4rem; line-height: 1.3; color: var(--ink-soft);
  }
  /* A pen tick in front of each. */
  .perks li { display: inline-flex; align-items: baseline; gap: 6px; }
  .perks li::before { content: '\2713'; color: var(--blue-ink); font-weight: 700; }
  /* Phones: the first game's cover and play button as high on the screen as the tape allows. */
  @media (max-width: 620px) {
    .hero { margin: 0 0 26px; }
    .intro { line-height: 1.15; }
    .perks { gap: 0 9px; font-size: 1.12rem; }
    .perks li { gap: 3px; }
  }
  /* One under another on phones; two side by side on wide screens. */
  .games { display: grid; grid-template-columns: minmax(0, 1fr); gap: 64px 48px; }
  @media (min-width: 900px) {
    .games { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 80px 48px; }
  }
  .more { margin-top: 88px; }
  .more-title { margin: 0 0 40px; font-family: var(--font-hand); font-size: 2.4rem; font-weight: 700; color: var(--ink); transform: rotate(-1deg); }
  @media (max-width: 620px) {
    .more { margin-top: 64px; }
    .more-title { margin-bottom: 28px; font-size: 2rem; }
  }
</style>
