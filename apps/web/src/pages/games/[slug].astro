---
import Base from '../../layouts/Base.astro';
import BuyButton from '../../components/BuyButton.astro';
import GameStats from '../../components/GameStats.astro';
import PartnerAd from '../../components/PartnerAd.astro';
import SundaySignup from '../../components/SundaySignup.astro';
import { findGame, isPurchasable, listedGames } from '../../data/games';
import { coverSrcset, coverVariant } from '../../lib/covers';
import { currentUser, ownedGameSlugs } from '../../lib/owner';
import { faqJsonLd, gameFaq, gameJsonLd, gameTitle } from '../../lib/seo';

// Rendered per request, so owners and signed-in players see their own page
// from the first paint (no flash of the free version).
export const prerender = false;

const game = findGame(Astro.params.slug ?? '');
if (!game || game.status !== 'playable') return new Response('Not found', { status: 404 });
// A game whose full version isn't out yet: a free demo, nothing to buy.
const forSale = isPurchasable(game);

let owned = false;
// Anyone who has bought any game sees no ads.
let ownsAny = false;
let ownedSlugs = new Set<string>();
let user: { name: string; email: string } | null = null;
try {
  const [slugs, session] = await Promise.all([ownedGameSlugs(Astro.cookies, Astro.url), currentUser(Astro.cookies)]);
  ownedSlugs = slugs;
  owned = slugs.has(game.slug);
  ownsAny = slugs.size > 0;
  user = session && { name: session.name, email: session.email };
} catch (err) {
  // The sales page must always load: fall back to the signed-out free version.
  console.error('[games] ownership check failed', err);
}
Astro.response.headers.set('cache-control', 'private, no-store');
const faq = gameFaq(game);
const site = Astro.site ?? Astro.url;
const cover = game.cover ?? '/covers/inkfish.png';
// Where a player lands on leaving a game: the other games, newest first, one tap from playing.
const others = listedGames(new Date()).filter((g) => g.slug !== game.slug).reverse();
---
<Base title={gameTitle(game)} description={game.description[0] ?? game.tagline} image={game.cover} user={user} jsonLd={[gameJsonLd(game, site), faqJsonLd(faq)]}>
  <article class="game">
    <div class="shot paper-card tape">
      <picture>
        <source type="image/avif" srcset={coverSrcset(cover, 'avif')} sizes="(min-width: 861px) 590px, calc(100vw - 52px)" />
        <source type="image/webp" srcset={coverSrcset(cover, 'webp')} sizes="(min-width: 861px) 590px, calc(100vw - 52px)" />
        <img src={coverVariant(cover, 1200, 'webp')} alt={`${game.title} gameplay`} width="1200" height="675" fetchpriority="high" />
      </picture>
    </div>
    <div class="info">
      <p class="pixel-label">{owned ? 'Full game · unlocked' : forSale ? `Free demo · full game ${game.price} one-time` : 'Free demo · the full game is coming soon'}</p>
      <h1>{game.title}</h1>
      <p class="tag">{game.tagline}</p>
      <div class="numbers"><GameStats game={game} owned={owned} large /></div>
      {game.description.map((p) => <p>{p}</p>)}
      <div class="actions">
        <a class="btn btn-ink" href={`/play/${game.slug}`}>{owned ? 'Play the full game' : 'Play free, full-screen'}</a>
        {!owned && forSale && <BuyButton game={game.slug} label={`Unlock full game · ${game.price}`} />}
      </div>
      {!forSale ? (
        <p class="one-time"><strong>Free to play.</strong> The demo is the whole first chapter, free and with no sign-up. The rest of the game is coming soon.</p>
      ) : owned ? (
        <p class="one-time"><strong>You own the full game.</strong> Every level is yours to keep, with nothing more to pay.</p>
      ) : (
        <p class="one-time"><strong>One-time purchase.</strong> Pay once and the full game is yours to keep: no subscription, no ads, nothing more to buy. Refunds within 14 days, see the <a href="/terms#refunds">terms</a>.</p>
      )}
      <p class="cancelled" hidden>Checkout cancelled. No charge was made.</p>
      {forSale && !owned && !user && <p class="restore">Bought it already? <a href={`/auth/google?return=/games/${game.slug}`}>Sign in with Google</a> with the email on your receipt to unlock it here.</p>}
      {forSale && !owned && <p class="restore">Got a key? <a href="/redeem">Redeem it here</a>.</p>}
      <div class="cols">
        {game.features && (
          <section>
            <h3>What you get</h3>
            <ul>{game.features.map((f) => <li>{f}</li>)}</ul>
          </section>
        )}
        {game.controls && (
          <section>
            <h3>Controls</h3>
            <ul>{game.controls.map((c) => <li>{c}</li>)}</ul>
          </section>
        )}
      </div>
    </div>
  </article>
  {others.length > 0 && (
    <section class="more" aria-labelledby="more-title">
      <h2 id="more-title">More games</h2>
      <ul>
        {others.map((g) => {
          const art = g.cover ?? '/covers/inkfish.png';
          return (
            <li>
              <a class="more-card" href={`/play/${g.slug}`}>
                <picture>
                  <source type="image/avif" srcset={coverSrcset(art, 'avif')} sizes="(min-width: 900px) 340px, calc(100vw - 32px)" />
                  <source type="image/webp" srcset={coverSrcset(art, 'webp')} sizes="(min-width: 900px) 340px, calc(100vw - 32px)" />
                  <img src={coverVariant(art, 640, 'webp')} alt="" width="1200" height="675" loading="lazy" decoding="async" />
                </picture>
                <span class="more-title">{g.title}</span>
                <span class="more-tag">{g.tagline}</span>
                <span class="more-play">{ownedSlugs.has(g.slug) ? 'Play' : 'Play free'} →</span>
              </a>
            </li>
          );
        })}
      </ul>
    </section>
  )}
  {!ownsAny && <PartnerAd />}
  <section class="faq" aria-labelledby="faq-title">
    <h2 id="faq-title">Questions</h2>
    <dl>
      {faq.map((f) => (
        <>
          <dt>{f.q}</dt>
          <dd>{f.a}</dd>
        </>
      ))}
    </dl>
  </section>
  <SundaySignup />
</Base>

<script>
  if (new URLSearchParams(location.search).get('checkout') === 'cancelled') {
    document.querySelector<HTMLElement>('.cancelled')?.removeAttribute('hidden');
  }
</script>

<style>
  .game { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: 48px; align-items: start; padding-top: 24px; }
  @media (max-width: 860px) { .game { grid-template-columns: 1fr; gap: 32px; } }
  .shot { padding: 10px; transform: rotate(-0.8deg); }
  .shot img { display: block; width: 100%; height: auto; border-radius: 2px; }
  .tag { font-family: var(--font-hand); font-size: 1.8rem; color: var(--blue-ink); margin: -6px 0 12px; }
  .numbers { margin: 0 0 18px; }
  .actions { display: flex; flex-wrap: wrap; gap: 14px; margin: 26px 0 10px; }
  .cancelled { color: var(--red-ink); }
  .one-time { margin: 0 0 6px; font-size: 1rem; }
  .one-time strong { color: var(--blue-ink); }
  .restore { color: var(--ink-soft); font-size: 0.95rem; margin: 4px 0 0; }
  .cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 8px 28px; margin-top: 28px; }
  ul { padding-left: 1.1em; margin: 0; }
  li { margin-bottom: 4px; }
  li::marker { content: '✎ '; color: var(--ink-faint); }
  .more { margin-top: 64px; }
  .more ul { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 32px; padding: 0; list-style: none; }
  .more li { margin: 0; }
  .more li::marker { content: none; }
  .more-card { display: flex; flex-direction: column; color: var(--ink); text-decoration: none; background: none; }
  .more-card picture { display: block; padding: 6px; background: var(--paper-2); border: 2px solid var(--ink); box-shadow: var(--shadow); transform: rotate(-0.6deg); transition: transform 0.2s ease; }
  .more-card:hover picture { transform: rotate(0deg); }
  .more-card:focus-visible { outline: 3px dashed var(--blue-ink); outline-offset: 6px; }
  .more-card img { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; }
  .more-title { margin-top: 12px; font-family: var(--font-hand); font-size: 2.2rem; font-weight: 700; line-height: 1; color: var(--blue-ink); }
  .more-tag { font-family: var(--font-hand); font-size: 1.3rem; line-height: 1.2; }
  .more-play { margin-top: 6px; font-weight: 600; }
  .faq { margin-top: 64px; max-width: 760px; }
  .faq dl { margin: 0; }
  .faq dt { font-family: var(--font-hand); font-size: 1.6rem; font-weight: 700; color: var(--blue-ink); margin-top: 18px; }
  .faq dd { margin: 2px 0 0; }
</style>
