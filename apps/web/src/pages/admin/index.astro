---
import Base from '../../layouts/Base.astro';
import { playableGames } from '../../data/games';
import { currentAdmin } from '../../lib/adminAuth';
import { grantedGamesFor } from '../../lib/db/grantRepo';
import { findPurchasesForUsers } from '../../lib/db/purchaseRepo';
import { listUsers } from '../../lib/db/userRepo';
import { isLocalHost } from '../../lib/devUnlock';
import { libraryOf, purchasesOf } from '../../lib/library';

export const prerender = false;

const PER_PAGE = 50;

Astro.response.headers.set('cache-control', 'private, no-store');
Astro.response.headers.set('x-robots-tag', 'noindex, nofollow');

const admin = await currentAdmin(Astro.cookies);
// Not found rather than forbidden: the admin area doesn't advertise itself.
if (!admin) return new Response('Not found', { status: 404 });

const search = (Astro.url.searchParams.get('q') ?? '').slice(0, 100);
const page = Math.max(0, Math.min(10_000, Number.parseInt(Astro.url.searchParams.get('page') ?? '0', 10) || 0));
const { users, total } = await listUsers({ search, page, perPage: PER_PAGE });
const [purchases, grants] = await Promise.all([findPurchasesForUsers(users.map((u) => u.id)), grantedGamesFor(users.map((u) => u.id))]);
const opts = { allowTestMode: isLocalHost(Astro.url.hostname) };
const rows = users.map((u) => ({ ...u, library: libraryOf(purchasesOf(u.id, purchases), grants.get(u.id) ?? [], opts) }));
const games = playableGames();
const here = Astro.url.pathname + Astro.url.search;
const pages = Math.max(1, Math.ceil(total / PER_PAGE));
const pageHref = (p: number): string => `/admin?${new URLSearchParams({ ...(search ? { q: search } : {}), page: String(p) })}`;
const day = (d: Date): string => d.toISOString().slice(0, 10);
---
<Base title="Admin · Users" description="16bit.ink administration" user={admin}>
  <meta name="robots" content="noindex, nofollow" slot="head" />
  <section class="admin">
    <nav class="admin-nav"><strong>Players</strong><a href="/admin/keys">Keys</a></nav>
    <h1>Players</h1>
    <form class="admin-search" method="get" action="/admin" role="search">
      <label for="q" class="visually-hidden">Search by email or name</label>
      <input id="q" name="q" type="search" value={search} placeholder="Search email or name" autocomplete="off" />
      <button class="btn" type="submit">Search</button>
    </form>
    <p class="admin-count">{total} {total === 1 ? 'player' : 'players'}{search && <> matching “{search}”</>}</p>

    <ul class="admin-users">
      {rows.map((u) => (
        <li class="admin-user">
          <div class="admin-who">
            <strong>{u.name}</strong>
            {u.role === 'admin' && <span class="admin-badge">admin</span>}
            <span class="admin-email">{u.email}</span>
            <span class="admin-dates">joined {day(u.createdAt)} · last sign-in {day(u.lastSignInAt)}</span>
          </div>
          <ul class="admin-games">
            {games.map((g) => {
              const bought = u.library.bought.includes(g.slug);
              const granted = u.library.granted.includes(g.slug);
              return (
                <li class="admin-game">
                  <span class="admin-game-title">{g.title}</span>
                  {bought && <span class="admin-state">bought</span>}
                  {granted && <span class="admin-state granted">unlocked by admin</span>}
                  {!bought && !granted && <span class="admin-state none">locked</span>}
                  <form method="post" action="/api/admin/grants">
                    <input type="hidden" name="userId" value={u.id} />
                    <input type="hidden" name="game" value={g.slug} />
                    <input type="hidden" name="return" value={here} />
                    {granted
                      ? <button class="btn btn-red" name="action" value="revoke" type="submit">Revoke</button>
                      : !bought && <button class="btn btn-ink" name="action" value="grant" type="submit">Unlock</button>}
                  </form>
                </li>
              );
            })}
          </ul>
        </li>
      ))}
    </ul>
    {rows.length === 0 && <p>No players{search ? ' match that search' : ' yet'}.</p>}

    {pages > 1 && (
      <nav class="admin-pages" aria-label="Pages">
        {page > 0 && <a href={pageHref(page - 1)}>← Newer</a>}
        <span>Page {page + 1} of {pages}</span>
        {page + 1 < pages && <a href={pageHref(page + 1)}>Older →</a>}
      </nav>
    )}
  </section>
</Base>

<style>
  .admin { padding-block: 24px 48px; }
  .admin-nav { display: flex; gap: 18px; margin-bottom: 8px; }
  .admin-search { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 8px; }
  .admin-search input {
    flex: 1 1 240px; min-width: 0; font: inherit; padding: 10px 12px;
    background: var(--paper-2); color: var(--ink); border: 2px solid var(--ink); border-radius: 4px;
  }
  .admin-search input:focus-visible { outline: 2px dashed var(--blue-ink); outline-offset: 3px; }
  .admin-count { color: var(--ink-soft); margin: 0 0 16px; }
  .admin-users { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
  .admin-user {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: 12px 24px; align-items: start;
    padding: 14px 16px; background: var(--paper-2); border: 2px solid var(--ink); border-radius: 4px;
  }
  .admin-who { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 10px; min-width: 0; }
  .admin-email { width: 100%; overflow-wrap: anywhere; }
  .admin-dates { width: 100%; font-size: 0.85rem; color: var(--ink-soft); }
  .admin-badge, .admin-state { font-family: var(--font-pixel); font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.06em; }
  .admin-badge { color: var(--red-ink); }
  .admin-games { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .admin-game { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 12px; }
  .admin-game-title { font-weight: 600; }
  .admin-state { color: var(--blue-ink); }
  .admin-state.none { color: var(--ink-faint); }
  .admin-game form { margin-left: auto; }
  .admin-game .btn { padding: 6px 14px; font-size: 0.95rem; }
  .admin-pages { display: flex; justify-content: center; align-items: center; gap: 20px; margin-top: 24px; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  @media (max-width: 640px) {
    .admin-user { grid-template-columns: minmax(0, 1fr); }
  }
</style>
