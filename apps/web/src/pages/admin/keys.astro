---
import Base from '../../layouts/Base.astro';
import { findGame, playableGames } from '../../data/games';
import { currentAdmin } from '../../lib/adminAuth';
import { listKeys } from '../../lib/db/keyRepo';
import { formatKey, MAX_KEY_USES, redeemUrl } from '../../lib/keys';

export const prerender = false;

const PER_PAGE = 100;

Astro.response.headers.set('cache-control', 'private, no-store');
Astro.response.headers.set('x-robots-tag', 'noindex, nofollow');

const admin = await currentAdmin(Astro.cookies);
// Not found rather than forbidden: the admin area doesn't advertise itself.
if (!admin) return new Response('Not found', { status: 404 });

const page = Math.max(0, Math.min(10_000, Number.parseInt(Astro.url.searchParams.get('page') ?? '0', 10) || 0));
const created = Astro.url.searchParams.get('created') === '1';
const { keys, total } = await listKeys({ page, perPage: PER_PAGE });
const games = playableGames();
const pages = Math.max(1, Math.ceil(total / PER_PAGE));
const day = (d: Date): string => d.toISOString().slice(0, 10);
const rows = keys.map((k, i) => ({
  ...k, shown: formatKey(k.code), link: redeemUrl(Astro.url.origin, k.code), fresh: created && page === 0 && i === 0,
  used: k.redemptions.length, full: k.redemptions.length >= k.uses,
}));
---
<Base title="Admin · Keys" description="16bit.ink administration" user={admin}>
  <meta name="robots" content="noindex, nofollow" slot="head" />
  <section class="admin">
    <nav class="admin-nav"><a href="/admin">Players</a><strong>Keys</strong></nav>
    <h1>Activation keys</h1>
    <p class="admin-hint">Each key unlocks one game for as many Google accounts as you allow, once per account. Send the link (or the key, to enter at <a href="/redeem">/redeem</a>).</p>

    <form class="admin-create" method="post" action="/api/admin/keys">
      <input type="hidden" name="action" value="create" />
      <label>Game
        <select name="game" required>{games.map((g) => <option value={g.slug}>{g.title}</option>)}</select>
      </label>
      <label>How many accounts
        <input name="uses" type="number" min="1" max={MAX_KEY_USES} value="1" required />
      </label>
      <label class="admin-note">For (optional)
        <input name="note" maxlength="80" placeholder="e.g. channel name" autocomplete="off" />
      </label>
      <button class="btn btn-ink" type="submit">Create key</button>
    </form>

    <p class="admin-count">{total} {total === 1 ? 'key' : 'keys'} · {rows.filter((k) => !k.full).length} with uses left on this page</p>
    <ul class="admin-keys">
      {rows.map((k) => (
        <li class:list={['admin-key', { fresh: k.fresh, used: k.full }]}>
          <code class="admin-code">{k.shown}</code>
          <span class="admin-key-meta">
            {findGame(k.game)?.title ?? k.game}{k.note && <> · <strong>{k.note}</strong></>} · created {day(k.createdAt)}
            {k.uses > 1 && <> · {k.used} of {k.uses} used</>}
          </span>
          {!k.full && (
            <span class="admin-key-actions">
              <button class="btn" type="button" data-copy={k.link}>Copy link</button>
              {k.used === 0 && (
                <form method="post" action="/api/admin/keys">
                  <input type="hidden" name="action" value="delete" />
                  <input type="hidden" name="code" value={k.code} />
                  <button class="btn btn-red" type="submit">Delete</button>
                </form>
              )}
            </span>
          )}
          {k.uses === 1 && k.redemptions[0] && (
            <span class="admin-state">redeemed by {k.redemptions[0].email} on {day(k.redemptions[0].at)}</span>
          )}
          {k.uses > 1 && k.used > 0 && (
            <details class="admin-redeemers">
              <summary>Redeemed by {k.used} {k.used === 1 ? 'account' : 'accounts'}</summary>
              <ul>{k.redemptions.map((r) => <li>{r.email} on {day(r.at)}</li>)}</ul>
            </details>
          )}
        </li>
      ))}
    </ul>
    {rows.length === 0 && <p>No keys yet.</p>}

    {pages > 1 && (
      <nav class="admin-pages" aria-label="Pages">
        {page > 0 && <a href={`/admin/keys?page=${page - 1}`}>← Newer</a>}
        <span>Page {page + 1} of {pages}</span>
        {page + 1 < pages && <a href={`/admin/keys?page=${page + 1}`}>Older →</a>}
      </nav>
    )}
  </section>
</Base>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('button[data-copy]')) {
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? '');
        button.textContent = 'Copied';
      } catch (err) {
        console.warn('[admin] copy failed', err);
        button.textContent = 'Copy failed';
      }
    });
  }
</script>

<style>
  .admin { padding-block: 24px 48px; }
  .admin-nav { display: flex; gap: 18px; margin-bottom: 8px; }
  .admin-hint, .admin-count { color: var(--ink-soft); }
  .admin-create {
    display: flex; flex-wrap: wrap; align-items: end; gap: 12px 16px; margin: 16px 0 24px;
    padding: 14px 16px; background: var(--paper-2); border: 2px solid var(--ink); border-radius: 4px;
  }
  .admin-create label { display: grid; gap: 4px; font-size: 0.9rem; color: var(--ink-soft); }
  .admin-create input, .admin-create select {
    font: inherit; color: var(--ink); padding: 8px 10px; background: var(--paper); border: 2px solid var(--ink); border-radius: 4px; min-width: 0;
  }
  .admin-create input[type='number'] { width: 7em; }
  .admin-note { flex: 1 1 200px; }
  .admin-keys { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .admin-key {
    display: flex; flex-wrap: wrap; align-items: center; gap: 6px 16px;
    padding: 10px 14px; background: var(--paper-2); border: 2px solid var(--ink); border-radius: 4px;
  }
  .admin-key.fresh { border-color: var(--blue-ink); box-shadow: 3px 3px 0 var(--blue-ink); }
  .admin-key.used { opacity: 0.7; }
  .admin-code { font-family: var(--font-pixel); font-size: 0.95rem; letter-spacing: 0.06em; user-select: all; }
  .admin-key-meta { flex: 1 1 200px; min-width: 0; overflow-wrap: anywhere; font-size: 0.95rem; }
  .admin-state { font-size: 0.9rem; color: var(--blue-ink); overflow-wrap: anywhere; }
  .admin-redeemers { flex: 1 0 100%; font-size: 0.9rem; color: var(--blue-ink); }
  .admin-redeemers summary { cursor: pointer; }
  .admin-redeemers ul { margin: 6px 0 0; padding-left: 20px; overflow-wrap: anywhere; }
  .admin-key-actions { display: flex; gap: 8px; margin-left: auto; }
  .admin-key .btn { padding: 6px 14px; font-size: 0.95rem; }
  .admin-pages { display: flex; justify-content: center; align-items: center; gap: 20px; margin-top: 24px; }
</style>
