---
/**
 * c4c.club partner cards: one on phones, two side by side on wide screens.
 * Each card posts its height to the page, or asks to be hidden when it has
 * nothing to show; the other card then takes the whole row, and the block
 * goes away once none is left.
 */
const SRC = 'https://c4c.club/embed?key=c4c_ffd5c63c47f8e517c582fba5&fit=content';
const MAX_HEIGHT = 400;
// Matches the home page, where the games go two to a row.
const WIDE = '(min-width: 900px)';
const SANDBOX = 'allow-scripts allow-popups allow-popups-to-escape-sandbox';
---
<aside class="partner" data-partner-ad data-max-height={MAX_HEIGHT} data-wide={WIDE} aria-label="Partner promotion">
  <!-- Both loaded from the script, after the page and only when scrolled near: the second on wide screens only. -->
  <iframe data-src={SRC} title="Partner promotion" scrolling="no" sandbox={SANDBOX}></iframe>
  <iframe class="wide-only" data-src={SRC} data-wide-only title="Partner promotion" scrolling="no" sandbox={SANDBOX}></iframe>
</aside>

<script>
  /** How far below the screen the cards start loading, so they're usually ready by the time they scroll in. */
  const AHEAD = '300px';
  /** Longest wait for the page's load event before watching anyway. */
  const LOAD_WAIT_MS = 8000;

  for (const block of document.querySelectorAll<HTMLElement>('[data-partner-ad]')) {
    const frames = Array.from(block.querySelectorAll('iframe'));
    const maxHeight = Number(block.dataset.maxHeight);
    const wide = matchMedia(block.dataset.wide ?? '');
    let near = false;

    const load = () => {
      if (!near) return;
      for (const frame of frames) {
        const wanted = !('wideOnly' in frame.dataset) || wide.matches;
        if (wanted && frame.dataset.src && !frame.getAttribute('src')) frame.src = frame.dataset.src;
      }
    };
    wide.addEventListener('change', load);

    // A third-party page (~330 KB of script) mustn't compete with the covers or hold back the load
    // event: wait for both (or a while, should something stall the load), then for the block to come near the screen.
    let watching = false;
    const watch = () => {
      if (watching) return;
      watching = true;
      const seen = new IntersectionObserver((entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        seen.disconnect();
        near = true;
        load();
      }, { rootMargin: `0px 0px ${AHEAD} 0px` });
      seen.observe(block);
    };
    if (document.readyState === 'complete') watch();
    else {
      window.addEventListener('load', watch, { once: true });
      setTimeout(watch, LOAD_WAIT_MS);
    }

    window.addEventListener('message', (event) => {
      // Sandboxed without same-origin, so the origin reads "null": match the frame itself.
      const frame = frames.find((candidate) => candidate.contentWindow === event.source);
      if (!frame || !event.data) return;
      if (event.data.type === 'c4c:collapse') {
        frame.hidden = true;
        block.hidden = frames.every((f) => f.hidden || !f.getAttribute('src'));
      }
      const height = Number(event.data.height);
      if (event.data.type === 'c4c:height' && height > 0 && height < maxHeight) frame.style.height = `${height}px`;
    });
  }
</script>

<style>
  .partner { display: flex; align-items: flex-start; gap: 48px; margin-top: 72px; }
  .partner[hidden] { display: none; }
  .partner iframe { display: block; flex: 1 1 0; min-width: 0; height: 96px; border: 0; color-scheme: normal; }
  .partner iframe[hidden] { display: none; }
  @media not (min-width: 900px) {
    .partner .wide-only { display: none; }
  }
</style>
