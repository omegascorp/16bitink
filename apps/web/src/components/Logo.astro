---
// A 16×16 pixel-art ink drop: the "16bit" and the "ink" in one mark.
const rows = [
  '.......##.......',
  '.......##.......',
  '......####......',
  '......####......',
  '.....######.....',
  '....########....',
  '...##########...',
  '...###@@#####...',
  '..###@@#######..',
  '..###@########..',
  '..############..',
  '..############..',
  '...##########...',
  '....########....',
  '.....######.....',
  '................',
];
const cells = rows.flatMap((row, y) => [...row].map((c, x) => ({ x, y, c }))).filter((p) => p.c !== '.');
---
<a href="/" class="logo" aria-label="16bit.ink home">
  <svg viewBox="0 0 16 16" aria-hidden="true" shape-rendering="crispEdges">
    {cells.map((p) => <rect x={p.x} y={p.y} width="1" height="1" fill={p.c === '@' ? 'var(--paper-2)' : 'var(--blue-ink)'} />)}
  </svg>
  <span><span class="bits">16bit</span><span class="ink">.ink</span></span>
</a>
