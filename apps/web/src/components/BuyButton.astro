---
interface Props {
  game: string;
  label: string;
  /** Sells the All Games Pass instead, offered on `game`'s page (or, as `game` "all", on the home page). */
  pass?: boolean;
  /** Where the offer is, for the stats. */
  where?: 'page' | 'home';
}
const { game, label, pass = false, where = 'page' } = Astro.props;
---
<buy-button data-game={game} data-pass={pass ? 'true' : undefined} data-where={where}>
  <button type="button" class={pass ? 'btn btn-ink' : 'btn btn-red'}>{label}</button>
  <p class="buy-error" role="alert" hidden></p>
</buy-button>

<script>
  import { PASS } from '../data/pass';
  import { BUY_PARAM, isPendingBuy } from '../lib/buyFlow';
  import { buyFullGame, startCheckout } from '../lib/client/checkout';

  /**
   * Sign in, then pay. The button only renders while the game is
   * not owned, so coming back from sign-in to a purchase the account already
   * holds never reaches checkout again.
   */
  class BuyButton extends HTMLElement {
    connectedCallback(): void {
      const button = this.querySelector('button');
      const error = this.querySelector<HTMLElement>('.buy-error');
      const game = this.dataset.game ?? '';
      const pass = this.dataset.pass === 'true';
      const where = this.dataset.where === 'home' ? 'home' : 'page';
      if (!button) return;
      const run = async (buy: (game: string) => Promise<{ error?: string }>): Promise<void> => {
        button.disabled = true;
        error?.setAttribute('hidden', '');
        const result = await buy(game);
        if (result.error && error) {
          error.textContent = result.error;
          error.removeAttribute('hidden');
        }
        button.disabled = false;
      };
      button.addEventListener('click', () => void run((g) => buyFullGame(g, where, pass)));
      if (isPendingBuy(window.location.search, pass ? PASS.slug : game)) {
        // Dropped first so Back or a reload never re-opens checkout.
        const url = new URL(window.location.href);
        url.searchParams.delete(BUY_PARAM);
        history.replaceState(null, '', url);
        void run((g) => startCheckout(g, pass));
      }
    }
  }
  customElements.define('buy-button', BuyButton);
</script>

<style>
  buy-button { display: contents; }
  .buy-error { flex-basis: 100%; color: var(--red-ink); margin: 0; }
</style>
