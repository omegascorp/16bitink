---
import type { CatalogGame } from '../data/games';

interface Props {
  game: CatalogGame;
  index: number;
}
const { game, index } = Astro.props;
const playable = game.status === 'playable';
const tilt = [-1.2, 0.9, -0.5][index % 3];
---
<article class:list={['card', { sketch: !playable }]} style={`--tilt:${tilt}deg`}>
  {playable ? (
    <a href={`/games/${game.slug}`} class="cover tape" aria-label={`${game.title} details`}>
      <img src={game.cover} alt={`${game.title} gameplay sketch`} width="1200" height="675" loading="lazy" />
    </a>
  ) : (
    <div class="cover placeholder" aria-hidden="true"><span>?</span></div>
  )}
  <div class="body">
    <p class="pixel-label">{playable ? 'Free demo · full game ' + game.price : 'In the sketchbook'}</p>
    <h3>{game.title}</h3>
    <p class="tagline">{game.tagline}</p>
    {playable && (
      <div class="actions">
        <a class="btn btn-ink" href={`/play/${game.slug}`}>Play free</a>
        <a class="btn" href={`/games/${game.slug}`}>Details</a>
      </div>
    )}
  </div>
</article>

<style>
  .card {
    position: relative; display: flex; flex-direction: column;
    background: var(--paper-2); border: 2px solid var(--ink); box-shadow: var(--shadow);
    border-radius: 6px 10px 8px 12px / 12px 6px 10px 6px;
    transform: rotate(var(--tilt)); transition: transform 0.2s ease;
  }
  .card:hover { transform: rotate(0deg) translateY(-3px); }
  .cover { position: relative; display: block; aspect-ratio: 16 / 9; border-bottom: 2px solid var(--ink); background: var(--paper); }
  .cover img { width: 100%; height: 100%; object-fit: cover; display: block; border-radius: 4px 8px 0 0; }
  .placeholder { display: grid; place-items: center; }
  .placeholder span { font-family: var(--font-hand); font-size: 6rem; color: var(--ink-faint); }
  .body { padding: 18px 20px 22px; }
  .tagline { margin: 0 0 16px; color: var(--ink-soft); }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .sketch { border-style: dashed; border-color: var(--ink-faint); box-shadow: none; color: var(--ink-faint); }
  .sketch .tagline { color: var(--ink-faint); }
</style>
