---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import Account from '../components/Account.astro';
import { appleTouchIcon } from '../lib/manifest';
import { canonicalUrl, jsonLdScript } from '../lib/seo';
import caveat from '../assets/fonts/caveat.woff2?url';
import sourceSerif from '../assets/fonts/source-serif-4.woff2?url';
import silkscreen from '../assets/fonts/silkscreen.woff2?url';

interface Props {
  title: string;
  description: string;
  image?: string;
  /** Server-rendered pages pass who is signed in (null: nobody); static pages leave it out. */
  user?: { readonly name: string; readonly email: string } | null;
  /** schema.org structured data for search engines (see lib/seo.ts). */
  jsonLd?: readonly unknown[];
}
const { title, description, image = '/covers/inkfish.png', user, jsonLd = [] } = Astro.props;
const canonical = canonicalUrl(Astro.url.pathname, Astro.site!);
const ogImage = new URL(image, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href={appleTouchIcon()} />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#f4eddc" />
    <meta property="og:site_name" content="16bit.ink" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd.map((data) => <script type="application/ld+json" set:html={jsonLdScript(data)} />)}
    <!-- The fonts the first screen draws with (see global.css), fetched alongside the stylesheet rather than after it.
         The same hashed URLs as the stylesheet's; one small enough to be inlined into it needs no fetch at all. -->
    {[caveat, sourceSerif, silkscreen].filter((href) => !href.startsWith('data:')).map((href) => (
      <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
    ))}
    <slot name="head" />
  </head>
  <body>
    <header class="wrap site-header">
      <Logo />
      <Account user={user} />
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="wrap site-footer">
      <span>© {new Date().getFullYear()} 16bit.ink</span>
      <span class="links"><a href="/games-like">Games like the classics</a><a href="/about">About</a><a href="/terms">Terms</a><a href="/privacy">Privacy</a></span>
    </footer>
    <script>
      import { setAnalyticsOptOut, trackPageview } from '../lib/client/analytics';
      import { watchErrors, watchPage } from '../lib/client/pageWatch';

      // Only admins ever see an /admin page: their browser stops counting itself in the stats.
      if (location.pathname.startsWith('/admin')) setAnalyticsOptOut(true);
      else {
        trackPageview();
        watchPage();
        watchErrors();
      }
    </script>
  </body>
</html>
