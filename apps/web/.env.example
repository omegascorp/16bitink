# Copy to .env for local development (never commit .env).
# In production, set these as encrypted environment variables on the
# DigitalOcean App Platform app (see Deploy in the README).
STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen --forward-to localhost:4321/api/webhook` locally.
STRIPE_WEBHOOK_SECRET=whsec_...
# Random 32+ byte string, e.g. `openssl rand -base64 48`
ENTITLEMENT_SECRET=change-me
STRIPE_AUTOMATIC_TAX=false
# Purchases database (MongoDB). Locally: a mongod on this machine.
MONGODB_URI=mongodb://localhost:27017/16bitink_dev
# Google sign-in (restores purchases on any device). Create an OAuth client
# (type "Web application") in Google Cloud Console, APIs & Services, Credentials,
# with redirect URI http://localhost:4321/auth/google/callback
GOOGLE_CLIENT_ID=....apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
# Admins, by the email of their Google account, comma-separated. They can open
# /admin to list players and unlock games for them. Roles are synced from this
# list on every server start and at sign-in; removing an email removes admin.
ADMIN_EMAILS=you@example.com
# Local only: every game counts as owned (no Stripe needed). Remove it to test
# the free version. Only works on localhost; never set it in production.
DEV_UNLOCK=true
# Local only: every level is playable without finishing the ones before it
# (paid chapters still need DEV_UNLOCK or a purchase). Only works on localhost.
DEV_ALL_LEVELS=true
